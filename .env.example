# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/x-composer

# Session and Token Security
SESSION_SECRET=replace_with_64_char_hex_secret
ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key

# Initial Super Admin Seed Credentials
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@xcomposer.local
SUPER_ADMIN_PASSWORD=AdminPass123!

# Official X API v2 Credentials (OAuth 2.0 PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/x-accounts/callback
X_CALLBACK_URL=http://localhost:3000/api/x-accounts/callback
X_OAUTH_SCOPES=users.read tweet.read tweet.write offline.access

# Official X Ads API v12 Credentials
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=

